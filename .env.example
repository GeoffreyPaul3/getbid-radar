# GetBidRadar Environment Variables

# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://<your-project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-key>"
SUPABASE_URL="https://<your-project-id>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# ─── AI Gateway Multi-Provider Cascade ───────────────────────────────────────
# 1. Primary: Google Gemini 2.5 Flash
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2. Fallback 1: Groq (llama-3.3-70b-versatile)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. Fallback 2: OpenRouter (google/gemini-2.5-flash)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"

# ─── Billing — PayChangu ─────────────────────────────────────────────────────
# Server-side secret key from https://app.paychangu.com/developers
PAYCHANGU_SECRET_KEY=""

# ─── Transactional Email — Resend ────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=""
# Verified "From" address (e.g. "GetBidRadar <billing@getbidradar.com>")
RESEND_FROM_EMAIL="GetBidRadar <onboarding@resend.dev>"

# ─── Application ─────────────────────────────────────────────────────────────
# Public URL of this deployment — used for PayChangu callback/return URLs
APP_URL="https://getbidradar.com"
